  },
  {
    "name": "empty actions tag after prose",
    "why": "a conversational reply with an empty container appended — the prose is the answer",
    "raw": "I'll look into that.\n<actions>\n</actions>"
  },
  {
    "name": "self-closing actions tag",
    "why": "the void form of the same container",
    "raw": "Nothing to do here.\n<actions/>"
  },
  {
    "name": "orphan actions opener",
    "why": "a reply truncated mid-block, or one still streaming",
