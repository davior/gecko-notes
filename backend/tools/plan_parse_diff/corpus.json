[
  {
    "name": "plain envelope",
    "why": "the contract the instructions ask for",
    "raw": "{\"actions\":[{\"type\":\"respond\",\"text\":\"Hello there.\"}]}"
  },
  {
    "name": "mixed plan",
    "why": "a reply alongside mutations — the common shape for a real edit",
    "raw": "{\"actions\":[{\"type\":\"respond\",\"text\":\"I'll rewrite the intro.\"},{\"type\":\"edit_section\",\"noteId\":\"n1\",\"section\":\"Intro\",\"content\":\"New intro.\"}]}"
  },
  {
    "name": "bare action object",
    "why": "models sometimes drop the envelope and emit one action",
    "raw": "{\"type\":\"respond\",\"text\":\"Just answering.\"}"
  },
  {
    "name": "json fence",
    "why": "a model that ignores 'no code fences'",
    "raw": "Here is the plan:\n```json\n{\"actions\":[{\"type\":\"rename_note\",\"noteId\":\"n1\",\"title\":\"New\"}]}\n```"
  },
  {
    "name": "bare fence",
    "why": "same, without the language tag",
    "raw": "```\n{\"actions\":[{\"type\":\"respond\",\"text\":\"Fenced.\"}]}\n```"
  },
  {
    "name": "prose either side",
    "why": "prose outside the envelope is the real answer and must survive",
    "raw": "Short answer: yes.\n\n{\"actions\":[{\"type\":\"append_note\",\"noteId\":\"n1\",\"content\":\"x\"}]}\n\nLet me know if that works."
  },
  {
    "name": "stray brace in prose first",
    "why": "a naive first-brace scan would hijack on the inline example and lose the plan",
    "raw": "Use the set {a, b} as your key.\n{\"actions\":[{\"type\":\"respond\",\"text\":\"Done.\"}]}"
  },
  {
    "name": "two fences, plan in the second",
    "why": "an illustrative snippet before the real plan",
    "raw": "Example input:\n```\nnot json\n```\n```json\n{\"actions\":[{\"type\":\"respond\",\"text\":\"Second.\"}]}\n```"
  },
  {
    "name": "blank run collapsing",
    "why": "outside prose keeps paragraphs but not four blank lines",
    "raw": "Line one.\n\n\n\nLine two.\n{\"actions\":[{\"type\":\"respond\",\"text\":\"r\"}]}"
  },
  {
    "name": "unescaped quote in content",
    "why": "the malformation the repair pass exists for: straight quotes inside a note body",
    "raw": "{\"actions\":[{\"type\":\"create_note\",\"title\":\"T\",\"content\":\"He said \"hello\" loudly.\"}]}"
  },
  {
    "name": "unescaped quote before a comma",
    "why": "the ambiguous case — a quoted phrase followed by a comma, still inside prose",
    "raw": "{\"actions\":[{\"type\":\"create_note\",\"title\":\"T\",\"content\":\"She wrote \"one\", then left.\"}]}"
  },
  {
    "name": "unescaped quote in an array element",
    "why": "in an array a comma really does close the element, unlike in an object",
    "raw": "{\"actions\":[{\"type\":\"set_tags\",\"noteId\":\"n1\",\"tags\":[\"a \"b\" c\",\"d\"],\"mode\":\"add\"}]}"
  },
  {
    "name": "unescaped quote at the very end of a value",
    "why": "closing quote followed by } — unambiguously a terminator",
    "raw": "{\"actions\":[{\"type\":\"respond\",\"text\":\"ends with \"a quote\"\"}]}"
  },
  {
    "name": "escaped quotes are left alone",
    "why": "a plan that already parses must never be touched by the repair pass",
    "raw": "{\"actions\":[{\"type\":\"respond\",\"text\":\"He said \\\"hi\\\".\"}]}"
  },
  {
    "name": "braces inside a string value",
    "why": "brace matching has to ignore structure inside string literals",
    "raw": "{\"actions\":[{\"type\":\"respond\",\"text\":\"the set {a, b} and }{ too\"}]}"
  },
  {
    "name": "actions tag wrapping an array",
    "why": "DeepSeek's usual shape",
    "raw": "<actions>[{\"type\":\"respond\",\"text\":\"Tagged.\"}]</actions>"
  },
  {
    "name": "actions tag wrapping an envelope",
    "why": "the same wrapper around a full envelope",
