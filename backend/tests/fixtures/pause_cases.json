      "text": "Chapter One [pause:2s]",
      "expect": "Chapter One"
    },
    {
      "text": "Intro [PAUSE] Part",
      "expect": "Intro Part"
    },
    {
      "text": "[pause:long]Heading",
      "expect": "Heading"
    },
    {
      "text": "No markers here",
      "expect": "No markers here"
    },
    {
      "text": "Keep the ellipsis…",
      "expect": "Keep the ellipsis…"
    }
  ],
  "chunk": [
    {
      "name": "markers stripped, pauses carried",
      "text": "One. Two [pause:2s] three... four.",
      "expect": [
        [
          "One.",
          250
        ],
        [
          "Two",
          2000
        ],
        [
          "three...",
          1300
        ],
        [
          "four.",
          0
        ]
      ]
    },
    {
      "name": "a blank line is a paragraph pause",
      "text": "One.\n\nTwo.",
      "expect": [
        [
          "One.",
          1600
