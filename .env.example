APP_PORT=8080

# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# REQUIRED in production — gates all API access; generate with: openssl rand -hex 32
APP_SECRET_TOKEN=

# REQUIRED in production — your public domain, e.g. https://notes.example.com
# Accepts a comma-separated list for multiple origins.
# Defaults to * (open) if not set — always set this in production.
CORS_ORIGIN=
