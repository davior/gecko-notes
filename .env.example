APP_PORT=8080

# Maximum file upload size (nginx format: 500m, 1g, 2g …). Defaults to 1g.
UPLOAD_MAX_SIZE=1g

# REQUIRED — generate with: openssl rand -hex 32
# The app will refuse to start if this is missing or uses the default value.
# Also used to derive the encryption key for stored AI provider API keys.
JWT_SECRET_KEY=

# OPTIONAL — your public domain, e.g. https://notes.example.com
# Accepts a comma-separated list for multiple origins.
# Defaults to no allowed origins (cross-origin requests blocked) if not set.
# Only needed if you access the API from a different origin than the frontend.
CORS_ORIGIN=
