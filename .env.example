APP_PORT=18081

# Maximum file upload size (nginx format: 500m, 1g, 2g …). Defaults to 1g.
UPLOAD_MAX_SIZE=1g

# REQUIRED — generate with: openssl rand -hex 32
# The app will refuse to start if this is missing or uses the default value.
# Also used to derive the encryption key for stored AI provider API keys.
JWT_SECRET_KEY=

# OPTIONAL — your public domain, e.g. https://notes.example.com
# Accepts a comma-separated list for multiple origins.
# Defaults to no allowed origins (cross-origin requests blocked) if not set.
# Only needed if you access the API from a different origin than the frontend.
CORS_ORIGIN=

# OPTIONAL — note version history.
# How often (minutes) the editor snapshots a note version while focused. Default 5.
NOTE_VERSION_INTERVAL_MINUTES=5
# Maximum number of versions kept per note; older ones are pruned. Default 50.
NOTE_VERSION_MAX_COUNT=50

# ─── Email (OPTIONAL) ─────────────────────────────────────────────────────────
# Enables welcome/verification emails, self-service password reset, and email-based
# 2FA. Email features stay OFF until both SMTP_HOST and SMTP_FROM are set — with no
# SMTP configured, new accounts skip verification and the app still works.
#
# Public origin used to build links inside emails (verification, password reset).
# Set this to how users reach the app, e.g. https://notes.example.com
APP_BASE_URL=
#
# SMTP server. Example values below are for SMTP2Go (see README for the full recipe).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The From address shown on outgoing mail, e.g. "Gecko Notes <admin@geckopico.com>"
SMTP_FROM=
# Transport security: STARTTLS (default) upgrades a plain connection on port 587/2525;
# set SMTP_SSL=true instead for an implicit-TLS port such as 465.
SMTP_STARTTLS=true
SMTP_SSL=false

# ─── Article-to-video rendering (OPTIONAL) ────────────────────────────────────
# "Generate video from article" narrates a note with your configured TTS voice
# and renders it to an MP4 with ffmpeg. It needs a speech provider configured
# under Settings → AI Services, and ffmpeg on the server (already in the image).
#
# How many renders may run at once. Encoding saturates the CPU and shares the
# container with the API, so the default of 1 keeps the app responsive.
RENDER_MAX_CONCURRENCY=1
# Refuse a render above these limits rather than spending a long time (and a lot
# of text-to-speech) on a note that was never meant to be a video.
VIDEO_MAX_SHOTS=200
VIDEO_MAX_NARRATION_CHARS=60000
# Rendered videos are large. Artefacts from jobs older than this are deleted on
# startup — unless the video was added to a note, which makes it that note's
# media and it is kept. Set to 0 to keep everything.
VIDEO_JOB_RETENTION_DAYS=14

# ─── Background jobs (OPTIONAL) ───────────────────────────────────────────────
# An approved AI-assistant plan is written and applied on the server, so closing
# the note (or the tab) no longer abandons it half-applied.
#
# How many plans may run at once.
ASSISTANT_MAX_CONCURRENCY=2
# How many recordings may be transcribed at once. Extracting audio is ffmpeg work
# that shares the container with the API, so the default of 1 keeps it responsive.
TRANSCRIBE_MAX_CONCURRENCY=1
# A running job says it is still alive on this interval, independently of progress —
# one body generation is a single upstream call that may run for tens of minutes with
# nothing to report in between.
JOB_HEARTBEAT_SECONDS=30
# A job that has not beaten for this long is treated as dead: it is ended and its note
# released. A backstop rather than the mechanism, so it sits well beyond any real run.
# A note held by a dead worker can also be released by hand from the indicator or the
# note's own banner, so nobody has to wait this out.
JOB_STALE_MINUTES=40

# ─── Backup (OPTIONAL) ─────────────────────────────────────────────────────────
# Off-site backup of data/db and data/media to a Synology NAS over SFTP, run on
# a schedule by the `backup` service in docker-compose.yml. See ops/backup/README.md
# for the full setup (NAS-side configuration, router port-forward, key exchange)
# and docs/backup-strategy.md for the design behind it.
#
# REQUIRED once you enable the backup service — restic's repository encryption
# password. Generate with: openssl rand -base64 32
# Losing this makes existing backups unrecoverable — store it outside this repo too.
RESTIC_PASSWORD=
#
# The NAS's WAN address/DDNS hostname and the router-forwarded SSH/SFTP port
# (not 22 — see ops/backup/README.md for why a direct port-forward should use
# a non-default port).
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=
# Dedicated, restricted DSM user with Read/Write on exactly one shared folder.
BACKUP_SFTP_USER=
# Path as it appears inside that user's SFTP session (their shared folder is "/"),
# NOT the real DSM path like /volume1/share/gecko-notes. Confirm with a manual
# `sftp` connection first — see ops/backup/README.md.
BACKUP_SFTP_REMOTE_PATH=/gecko-notes
#
# Standard 5-field cron expression, interpreted in TZ below. Default: hourly.
BACKUP_CRON_SCHEDULE=0 * * * *
# Retention: restic forget --keep-hourly/--keep-daily/--keep-weekly --prune.
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# OPTIONAL — Docker Compose file selection.
# If deploying behind a reverse proxy (Caddy, Nginx, etc.) on a shared Docker network
# (e.g., davior/infra with a 'web' network), set this to include the prod overlay:
#
#   COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
#
# This ensures the frontend always joins the external 'web' network and remains
# reachable from the reverse proxy. Without it, plain `docker compose up` drops
# the network attachment, resulting in 502 errors. See CLAUDE.md for details.
